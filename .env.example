# ===== AI 服务商（阶段 3 需要）=====
# 默认用 DeepSeek（兼容 OpenAI 接口）；可切换为 anthropic，见说明书 9.5
LLM_PROVIDER=deepseek
# DeepSeek 的 API key，在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
# 只有当 LLM_PROVIDER=anthropic 时才需要填下面这个（可选）
# ANTHROPIC_API_KEY=

# ===== 本地数据库（不上传 GitHub，见 .gitignore）=====
DATABASE_URL="file:./dev.db"

# ===== 本地抓取新闻用的代理（国内访问 Google 需要；GitHub Actions 里不用设）=====
HTTPS_PROXY="http://127.0.0.1:8890"

# ===== 邮件周刊（阶段 5 需要，现在可留空）=====
# 收件邮箱（V1 只发给自己，本地 .env / GitHub Secret，绝不上传）
RECIPIENT_EMAIL="you@example.com"
# 没有 key 时只演练、不真正发送（Resend：https://resend.com）
RESEND_API_KEY=
SITE_URL="http://localhost:3000"
